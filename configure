#!/usr/bin/env python3
import argparse
import ninja_syntax as ninja
import os
import sys

ROOTDIR = os.path.dirname(os.path.abspath(__file__))
parser = argparse.ArgumentParser(description="Configure the build system")
parser.add_argument("-B", dest="build_dir", default=ROOTDIR, help="Explicitly specify a build directory")
args = parser.parse_args()
BUILDDIR = os.path.abspath(args.build_dir)

with open(f"{BUILDDIR}/build.ninja", "w+") as f:
    writer = ninja.Writer(f)
    writer.variable("cc", os.getenv("CC", "clang"))
    writer.rule("cc", "$cc -MD -MF $out.d $cflags -c -o $out $in", depfile="$out.d", deps="gcc")
    writer.rule("ld", "$cc -o $out $in $ldflags")
    objs = []
    objs += writer.build("main.o", "cc", f"{ROOTDIR}/main.c")
    objs += writer.build("lib.o", "cc", f"{ROOTDIR}/lib.c")
    writer.build("main", "ld", objs)

    writer.rule("regen_ninja", f"{sys.executable} $in")
    writer.build("build.ninja", "regen_ninja", f"{ROOTDIR}/configure")
    writer.close()
